# ============================================
# AI Resume Analyzer — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ============================================

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MongoDB ----
MONGODB_URI=

# ---- JWT Authentication ----
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- AI / LLM ----
AI_API_KEY=

# ---- Client ----
CLIENT_URL=http://localhost:5173

# ---- File Uploads ----
MAX_FILE_SIZE_MB=5
